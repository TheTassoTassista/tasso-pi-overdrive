FROM docker.io/library/archlinux:base@sha256:3c64b538588416593f69a1aebd2f2ec0f2541b29159f32556fa7def2167147a0
ARG PRODUCT_CANDIDATE_SHA
LABEL org.opencontainers.image.revision="${PRODUCT_CANDIDATE_SHA}"

# Package dependencies supply libraries and utilities; the security-relevant
# executables below are replaced by verified immutable seed assets. The pinned
# Node binary also needs its exact SONAME-compatible runtime library.
RUN pacman -Syu --noconfirm --needed \
      bash coreutils findutils grep gawk sed tar git gdb python python-pip nodejs npm util-linux binutils \
      gcc make cmake go openssh curl ca-certificates bubblewrap \
      alsa-lib at-spi2-core cairo fontconfig gtk3 libdrm libcups libx11 libxcomposite \
      libxdamage libxext libxfixes libxi libxkbcommon libxrandr mesa nspr nss pango ttf-liberation \
    && pacman -Scc --noconfirm
COPY --from=seeds /usr /usr
COPY --from=seeds /opt/phi/browser /opt/phi/browser
# Only clangd is a Phi C/C++ LSP contract. Fetch the exact official release
# during the controlled build and retain only its independently pinned binary.
RUN set -eu; \
    archive=/tmp/LLVM-22.1.8-Linux-X64.tar.xz; \
    curl --fail --location --silent --show-error --retry 0 \
      'https://github.com/llvm/llvm-project/releases/download/llvmorg-22.1.8/LLVM-22.1.8-Linux-X64.tar.xz' -o "$archive"; \
    test "$(stat -c %s "$archive")" = 1938859476; \
    echo 'df0e1ecf16caf3489a272a5eea4eec9b0d82878f6477fa309504f918a0006384  /tmp/LLVM-22.1.8-Linux-X64.tar.xz' | sha256sum -c -; \
    mkdir -p /usr/local/lib/phi/llvm/22.1.8/bin; \
    tar -xJf "$archive" --no-same-owner --no-same-permissions \
      --strip-components=1 -C /usr/local/lib/phi/llvm/22.1.8 \
      LLVM-22.1.8-Linux-X64/bin/clangd; \
    test "$(stat -c %s /usr/local/lib/phi/llvm/22.1.8/bin/clangd)" = 106012688; \
    echo 'aacb4651e1886b98c5413369fc1789f4ca2d4fa5b94fdf0de4f48c98a52d4324  /usr/local/lib/phi/llvm/22.1.8/bin/clangd' | sha256sum -c -; \
    test "$(/usr/local/lib/phi/llvm/22.1.8/bin/clangd --version | head -n 1)" = 'clangd version 22.1.8 (https://github.com/llvm/llvm-project ca7933e47d3a3451d81e72ac174dcb5aa28b59d1)'; \
    rm "$archive"
RUN if test "$(readlink /usr/lib/libsimdjson.so.33)" = "libsimdjson.so.33.0.0" \
      && echo '8ed9852623a4d807d135abe39b3a09a31147462148cbd5b8aad34f490637712c  /usr/lib/libsimdjson.so.33.0.0' | sha256sum -c - \
      && readelf -d /usr/bin/node | grep -Fq 'Shared library: [libsimdjson.so.33]' \
      && /lib64/ld-linux-x86-64.so.2 --list /usr/bin/node | grep -Fq 'libsimdjson.so.33 => /usr/lib/libsimdjson.so.33' \
      && test "$(/usr/bin/node --version)" = 'v26.8.2'; then \
      echo 'E4_IMAGE_NODE_ELF_CLOSURE=PASS'; \
    else \
      echo 'TOOLCHAIN_RUNTIME_DEPENDENCY_MISSING tool=node soname=libsimdjson.so.33 rootfs=phi-e4-host-v1' >&2; \
      exit 1; \
    fi

COPY certification/pi/package.json certification/pi/package-lock.json /opt/phi/pi/npm/
RUN npm ci --prefix /opt/phi/pi/npm --legacy-peer-deps --no-audit --no-fund

COPY runtime/lsp/package.json runtime/lsp/package-lock.json /opt/phi/runtime/lsp/
RUN npm ci --prefix /opt/phi/runtime/lsp --ignore-scripts --no-audit --no-fund
COPY --from=lsp / /opt/phi/runtime/lsp/managed/
COPY scripts/install-managed-lsp.mjs /opt/phi/scripts/install-managed-lsp.mjs
COPY lib/managed-runtime-transaction.mjs /opt/phi/lib/managed-runtime-transaction.mjs
COPY config/managed-lsp.json /opt/phi/config/managed-lsp.json
RUN node /opt/phi/scripts/install-managed-lsp.mjs --runtime /opt/phi/runtime/lsp --check

COPY config/dap-requirements.txt /opt/phi/config/dap-requirements.txt
COPY scripts/install-managed-dap.sh /opt/phi/scripts/install-managed-dap.sh
RUN bash /opt/phi/scripts/install-managed-dap.sh

COPY config/e4-toolchain-seeds.json config/e4-llvm-toolchain.json config/git-resources.json config/dap-engine.json config/eval-engine.json config/ast-edit.json /opt/phi/config/
COPY certification/pi/package-lock.json /opt/phi/config/pi-package-lock.json
COPY package.json /opt/phi/project/package.json
COPY config/routing-policy.json /opt/phi/project/config/routing-policy.json
COPY lib/ /opt/phi/project/lib/
COPY platform/ /opt/phi/project/platform/
COPY tests/agent-hub-control-bridge.test.mjs tests/ast-edit-engine.test.mjs /opt/phi/project/tests/
RUN ln -s /opt/phi/pi/npm/node_modules /opt/phi/project/node_modules
COPY scripts/e4-image-selfcheck.mjs /opt/phi/e4-image-selfcheck.mjs
COPY scripts/e4-executable-inventory.mjs /opt/phi/e4-executable-inventory.mjs
COPY scripts/e4-lsp-startup-smoke.mjs /opt/phi/e4-lsp-startup-smoke.mjs
COPY scripts/e4-rust-startup.mjs /opt/phi/e4-rust-startup.mjs
COPY scripts/e4-rust-diagnostic.mjs /opt/phi/e4-rust-diagnostic.mjs
COPY scripts/e4-linker-capture.mjs /opt/phi/e4-linker-capture.mjs
COPY scripts/e4-rust-linker-diagnostic.mjs /opt/phi/e4-rust-linker-diagnostic.mjs
COPY scripts/e4-clangd-lsp-smoke.mjs /opt/phi/e4-clangd-lsp-smoke.mjs
RUN mkdir -p /phi /evidence /run /tmp \
    && chmod -R a+rX /opt/phi \
    && test -z "$(find /phi -mindepth 1 -print -quit)"

USER 1001:1001
ENV HOME=/tmp
ENTRYPOINT ["/usr/bin/node", "/opt/phi/e4-image-selfcheck.mjs"]
