{
  "version": 1,
  "enabled": true,
  "protocolVersion": 1,
  "expectedPiVersion": "1.5.0",
  "maxSessions": 1,
  "maxConcurrentPrompts": 1,
  "maxFrameBytes": 65536,
  "maxPiFrameBytes": 2097152,
  "maxPromptChars": 16000,
  "maxUpdateChars": 32768,
  "commandTimeoutMs": 30000,
  "promptTimeoutMs": 3600000,
  "permissionTimeoutMs": 120000,
  "shutdownTimeoutMs": 5000,
  "maxReceiptEvents": 4096,
  "maxReceiptBytes": 1048576,
  "allowSessionPersistence": false,
  "allowClientMcp": false,
  "allowAdditionalDirectories": false,
  "allowClientFilesystem": false,
  "allowClientTerminal": false,
  "allowClientRouteChanges": false,
  "allowSlashCommands": false,
  "approvalTools": [
    "agent_browser",
    "ast_grep_rewrite",
    "bash",
    "debug_engine",
    "edit",
    "mcp",
    "persistent_javascript",
    "persistent_python",
    "powershell",
    "safe_exec",
    "safe_remove_file",
    "safe_web_fetch",
    "secure_coding_workflow",
    "subagent",
    "transactional_ast_edit",
    "transactional_edit",
    "verification_gate",
    "web_research",
    "write"
  ]
}
