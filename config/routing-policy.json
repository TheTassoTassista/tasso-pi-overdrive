        "scout": { "mode": "conditional", "chain": [["qwen-fast", "off"], ["luna", "low"], ["auto-fast", "off"]] },
        "planner": { "mode": "conditional", "chain": [["deepseek-reasoning", "off"], ["sol", "high"], ["qwen-reasoning", "off"], ["auto-reasoning", "off"]] },
        "oracle": { "mode": "conditional", "chain": [["deepseek-reasoning", "off"], ["astra", "high"], ["sol", "high"]] },
        "worker": { "mode": "enabled", "chain": [["qwen-coding", "off"], ["deepseek-coding", "off"], ["terra", "high"], ["auto-coding", "off"]] },
        "tester": { "mode": "conditional", "chain": [["qwen-fast", "off"], ["luna", "medium"], ["terra", "medium"]] },
        "correctness": { "mode": "conditional", "chain": [["deepseek-reasoning", "off"], ["sol", "high"], ["astra", "high"]] },
        "security": { "mode": "conditional-mandatory-on-risk", "chain": [["sol", "high"], ["astra", "high"]] },
        "simplicity": { "mode": "conditional", "chain": [["qwen-fast", "off"], ["luna", "medium"]] },
        "council-1": { "mode": "conditional", "chain": [["sol", "high"], ["astra", "high"]] },
        "council-2": { "mode": "conditional", "chain": [["deepseek-reasoning", "off"], ["gpt55", "high"], ["sol", "high"]] },
