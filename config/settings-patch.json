{
  "defaultProjectTrust": "ask",
  "defaultTools": [
    "read",
    "edit",
    "write"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-sol",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "openai-codex/gpt-5.3-codex-spark",
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6-sol",
    "openai-codex/gpt-6-astra",
    "omniroute/auto/best-coding",
    "omniroute/auto/best-fast",
    "omniroute/auto/best-reasoning",
    "omniroute/deepseek/deepseek-v4-flash",
    "omniroute/deepseek/deepseek-v4-pro-high",
    "omniroute/groq/qwen/qwen3-32b",
    "omniroute/openrouter/qwen/qwen3-coder-next",
    "omniroute/openrouter/qwen/qwen3.8-27b"
  ],
  "showCacheMissNotices": true,
  "enableSkillCommands": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 16000
  },
  "subagents": {
    "defaultModel": "openai-codex/gpt-6-sol",
    "defaultProvider": "openai-codex",
    "defaultThinking": "medium",
    "maxThinking": "max",
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "inherit",
        "openai-codex/gpt-5.3-codex-spark",
        "openai-codex/gpt-5.5",
        "openai-codex/gpt-5.6-luna",
        "openai-codex/gpt-5.6-sol",
        "openai-codex/gpt-5.6-terra",
        "openai-codex/gpt-6-luna",
        "openai-codex/gpt-6-sol",
        "openai-codex/gpt-6-astra",
        "omniroute/auto/best-coding",
        "omniroute/auto/best-fast",
        "omniroute/auto/best-reasoning",
        "omniroute/deepseek/deepseek-v4-flash",
        "omniroute/deepseek/deepseek-v4-pro-high",
        "omniroute/groq/qwen/qwen3-32b",
        "omniroute/openrouter/qwen/qwen3-coder-next",
        "omniroute/openrouter/qwen/qwen3.8-27b"
      ]
    },
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "low"
      },
      "planner": {
        "model": "openai-codex/gpt-6-sol",
        "thinking": "medium"
      },
      "oracle": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "high"
      },
      "worker": {
        "model": "openai-codex/gpt-6-sol",
        "thinking": "medium"
      },
      "tester": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "medium"
      },
      "correctness-reviewer": {
        "model": "openai-codex/gpt-6-sol",
        "thinking": "medium"
      },
      "security-reviewer": {
        "model": "openai-codex/gpt-6-sol",
        "thinking": "high"
      },
      "simplicity-reviewer": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "medium"
      },
      "council-1": {
        "model": "openai-codex/gpt-6-sol",
        "thinking": "high"
      },
      "council-2": {
        "model": "openai-codex/gpt-5.5",
        "thinking": "high"
      },
      "council-3": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "high"
      },
      "council-judge": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "high"
      }
    }
  }
}
