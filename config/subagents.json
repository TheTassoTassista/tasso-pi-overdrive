{
  "toolDescriptionMode": "compact",
  "inlineToolDisplay": "summary",
  "mainWindowRenderer": {
    "horizontalSpacing": 0,
    "compactResultMaxLines": 4
  },
  "asyncByDefault": false,
  "defaultSubagentContext": "fresh",
  "waitTool": {
    "enabled": true,
    "defaultTimeoutMs": 120000
  },
  "timeoutMs": 3600000,
  "toolTimeoutMs": 600000,
  "globalConcurrencyLimit": 3,
  "maxSubagentSpawnsPerSession": 24,
  "maxSubagentSpawnsPerRun": 8,
  "maxActiveAsyncRunsPerSession": 3,
  "parallel": {
    "maxTasks": 3,
    "concurrency": 3
  },
  "maxSubagentDepth": 1,
  "worktree": false,
  "worktreeBaseDir": "~/.local/share/pi-overdrive/worktrees",
  "worktreeProvider": "native",
  "worktreeBranchPrefix": "pi-overdrive/",
  "scheduledRuns": {
    "enabled": false,
    "maxPending": 8
  },
  "missions": {
    "enabled": false,
    "globalIndex": false,
    "retainTerminal": 25
  },
  "permissions": {
    "rules": {
      "edit": "deny",
      "write": "deny"
    }
  },
  "intercomBridge": {
    "mode": "off",
    "resultDelivery": false
  }
}
