{
  "version": 2,
  "enabled": true,
  "platform": "linux-x64",
  "adapter": {
    "id": "gdb",
    "binaryPath": "/usr/bin/gdb",
    "binaryVersion": "GNU gdb (GDB) 17.2",
    "binarySha256": "5a159b8868d53a85bee261bc35dc59437800b1d139d0389d83e4fdee5a24945d",
    "arguments": [
      "-q",
      "-nx",
      "-nh",
      "-iex",
      "set auto-load off",
      "-iex",
      "set debuginfod enabled off",
      "-i",
      "dap"
    ]
  },
  "secondaryAdapters": [
    {
      "id": "debugpy",
      "binaryPath": "/usr/bin/python3.14",
      "binaryVersion": "Python 3.14.7",
      "binarySha256": "dd65a07e8f535525443d63e2bd6dd10efbf22bf22e0b6d65e634266acc7ac976",
      "arguments": ["-m", "debugpy.adapter"],
      "moduleVersion": "1.8.22",
      "moduleRelative": "runtime/dap/python/debugpy",
      "moduleSha256": "28fd1a1c1eaaa19efc055c51ee576ec9326726fa81ca1c95727383ae42756636"
    }
  ],
  "startupTimeoutMs": 15000,
  "requestTimeoutMs": 10000,
  "idleTimeoutMs": 300000,
  "shutdownGraceMs": 1000,
  "maxMessageBytes": 1048576,
  "maxOutputBytes": 131072,
  "maxStderrBytes": 16384,
  "maxArguments": 64,
  "maxArgumentChars": 4096,
  "maxProgramBytes": 268435456,
  "maxSourceBytes": 8388608,
  "maxBreakpoints": 32,
  "maxStackFrames": 32,
  "maxVariables": 100,
  "maxValueChars": 4096
}
